{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/avatar/**",
              "components/chyron/**",
              "components/episode-card/**",
              "components/form/**",
              "components/icon/**",
              "components/menu/**",
              "components/pill/**",
              "components/review-card/**",
              "components/scoring/**",
              "components/seal/**",
              "components/search/**",
              "components/tabs/**",
              "ui_kits/trackstar-app/**",
              "ui_kits/trackstar-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|alt|className|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, alt, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|href|disabled|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, href, disabled, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|small)$/]",
        "message": "<Button> size must be one of 'default' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CertifiedSeal'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|score|ratings|scores|required|size|compact|className|style|key|ref|className|style|children)$/]",
        "message": "<CertifiedSeal> doesn't accept that prop. Declared props: state, score, ratings, scores, required, size, compact, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CertifiedSeal'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:certified|locked)$/]",
        "message": "<CertifiedSeal> state must be one of 'certified' | 'locked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|helper|checked|defaultChecked|onChange|disabled|status|className|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, helper, checked, defaultChecked, onChange, disabled, status, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:bad)$/]",
        "message": "<Checkbox> status must be one of 'bad'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chyron'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|name|meta|size|className|style|key|ref|className|style|children)$/]",
        "message": "<Chyron> doesn't accept that prop. Declared props: kicker, name, meta, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chyron'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|card)$/]",
        "message": "<Chyron> size must be one of 'hero' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EpisodeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|format|still|date|duration|playable|size|href|className|style|key|ref|className|style|children)$/]",
        "message": "<EpisodeCard> doesn't accept that prop. Declared props: title, format, still, date, duration, playable, size, href, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EpisodeCard'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:testing|versus|tensongs|live|talk|extended)$/]",
        "message": "<EpisodeCard> format must be one of 'testing' | 'versus' | 'tensongs' | 'live' | 'talk' | 'extended'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EpisodeCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:large|small)$/]",
        "message": "<EpisodeCard> size must be one of 'large' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldInfo'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|side|className|style|key|ref|className|style|children)$/]",
        "message": "<FieldInfo> doesn't accept that prop. Declared props: label, children, side, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldInfo'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:start|end)$/]",
        "message": "<FieldInfo> side must be one of 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|value|defaultValue|onChange|placeholder|name|id|status|statusText|helper|disabled|required|rows|options|className|style|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: label, type, value, defaultValue, onChange, placeholder, name, id, status, statusText, helper, disabled, required, rows, options, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|password|tel|url|number|textarea|select)$/]",
        "message": "<FormField> type must be one of 'text' | 'email' | 'password' | 'tel' | 'url' | 'number' | 'textarea' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|bad)$/]",
        "message": "<FormField> status must be one of 'ok' | 'bad'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:play|pause|search|headphones|heart|bookmark|list|plus|comment|share|chevron|external|disc|mic|close|sliders|seal)$/]",
        "message": "<Icon> name must be one of 'play' | 'pause' | 'search' | 'headphones' | 'heart' | 'bookmark' | 'list' | 'plus' | 'comment' | 'share' | 'chevron' | 'external' | 'disc' | 'mic' | 'close' | 'sliders' | 'seal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|trailing|selected|disabled|divider|href|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: label, icon, trailing, selected, disabled, divider, href, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|empty|icon|className|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, size, empty, icon, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|big)$/]",
        "message": "<Pill> size must be one of 'default' | 'big'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StandoutTrack'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|duration|key|ref|className|style|children)$/]",
        "message": "<StandoutTrack> doesn't accept that prop. Declared props: title, duration."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreDial'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|onChange|size|state|caption|onReset|onUndo|className|style|key|ref|className|style|children)$/]",
        "message": "<ScoreDial> doesn't accept that prop. Declared props: value, defaultValue, onChange, size, state, caption, onReset, onUndo, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreDial'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:scored|empty|cleared)$/]",
        "message": "<ScoreDial> state must be one of 'scored' | 'empty' | 'cleared'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|onSubmit|readOnly|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<SearchBar> doesn't accept that prop. Declared props: value, onChange, placeholder, onSubmit, readOnly, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
